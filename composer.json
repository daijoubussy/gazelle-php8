{
    "name": "oppaitime/gazelle",
    "description": "OppaiTime Gazelle - A modern PHP 8.5 torrent tracker with clean architecture",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-mysqli": "*",
        "ext-pdo": "*",
        "ext-memcached": "*",
        "ext-apcu": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-openssl": "*",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Gazelle\\": "src/",
            "Gazelle\\Core\\": "src/Core/",
            "Gazelle\\Domain\\": "src/Domain/",
            "Gazelle\\Application\\": "src/Application/",
            "Gazelle\\Infrastructure\\": "src/Infrastructure/",
            "Gazelle\\Http\\": "src/Http/"
        },
        "classmap": [
            "classes/"
        ],
        "files": [
            "src/helpers.php",
            "classes/util.php",
            "classes/regex.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gazelle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "phpcs",
        "serve": "php -S localhost:8080 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        }
    },
    "minimum-stability": "stable"
}
