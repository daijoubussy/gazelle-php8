{
    "name": "oppaitime/gazelle",
    "description": "OppaiTime Gazelle - A secure PHP torrent tracker framework upgraded to PHP 8.5",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-mysqli": "*",
        "ext-memcached": "*",
        "ext-apcu": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Gazelle\\": "src/"
        },
        "classmap": [
            "classes/"
        ],
        "files": [
            "classes/util.php",
            "classes/regex.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gazelle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "phpcs"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        }
    },
    "minimum-stability": "stable"
}
